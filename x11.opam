opam-version: "2.0"
synopsis: "X11 bindings for OCaml"
description:
  "Type-safe OCaml bindings to Xlib, built with ctypes. X's integer constants become variants and typed masks, so that values X would reject don't type-check. The bindings are incomplete and grow toward what a simple window manager needs."
authors: ["Vianney HERVY <vian.hervy@gmail.com>"]
license: "MIT"
tags: ["x11" "xlib" "bindings" "ctypes" "window manager"]
homepage: "https://github.com/sully-vian/x11"
doc: "https://sully-vian.github.io/x11/"
bug-reports: "https://github.com/sully-vian/x11/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml"
  "ctypes"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/sully-vian/x11.git"
x-maintenance-intent: ["(latest)"]
