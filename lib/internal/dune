(library
 (name x11_internal)
 ; private library: installed with the x11 package (as
 ; x11.__private__.x11_internal) but not usable by other projects
 (package x11)
 (libraries ctypes ctypes.stubs)
 (c_library_flags (-lX11))
 (ctypes
  (external_library_name x11)
  ; ctypes keys each enum on its C type name, so int-valued X constants get
  ; distinct typedefs of int
  (headers
   (preamble
    "#include <X11/X.h>\n#include <X11/Xlib.h>\n#include <X11/Xutil.h>\ntypedef int x11_event_type;\ntypedef int x11_notify_mode;\ntypedef int x11_notify_detail;\ntypedef int x11_stack_mode;\ntypedef int x11_property_state;\ntypedef int x11_window_class;\ntypedef int x11_map_state;\ntypedef int x11_backing_store;\ntypedef int x11_bit_gravity;\ntypedef int x11_win_gravity;\ntypedef int x11_grab_mode;\ntypedef int x11_mapping_request;"))
  (type_description
   (instance Types)
   (functor type_description))
  (function_description
   (instance Functions)
   (functor function_description))
  (generated_entry_point C)))
