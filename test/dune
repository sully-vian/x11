; Main test library

(test
 (name test_x11)
 (action
  (run %{test} --show-errors))
 (modules test_x11)
 (libraries
  alcotest
  test_xwindowattributes
  test_xevent
  test_xevent2
  test_x
  test_compilation
  test_integration))

(library
 (name test_xwindowattributes)
 (modules test_xwindowattributes)
 (foreign_stubs
  (language c)
  (names test_xwindowattributes))
 (libraries x11 alcotest))

(library
 (name test_xevent2)
 (modules test_xevent2)
 (foreign_stubs
  (language c)
  (names test_xevent2))
 (libraries x11 alcotest))

(library
 (name test_xevent)
 (modules test_xevent)
 (foreign_stubs
  (language c)
  (names test_xevent))
 (libraries x11 alcotest))

(library
 (name test_integration)
 (modules test_integration)
 (libraries x11 alcotest))

(library
 (name test_x)
 (modules test_x)
 (libraries x11 alcotest))

(library
 (name test_compilation)
 (modules test_compilation)
 (libraries x11 alcotest))

(rule
 (with-stdout-to
  test_xevent.c.formatted
  (run clang-format %{dep:test_xevent.c})))

(rule
 (with-stdout-to
  test_xevent2.c.formatted
  (run clang-format %{dep:test_xevent2.c})))

(rule
 (alias fmt)
 (action
  (progn
   (diff test_xevent.c test_xevent.c.formatted)
   (diff test_xevent2.c test_xevent2.c.formatted))))
