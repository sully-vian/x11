; Main test library

(library
 (name test_x11)
 (modules test_x11)
 (libraries x11 test_xevent alcotest))

; XEvent conversion tests

(library
 (name test_xevent)
 (modules test_xevent)
 (foreign_stubs
  (language c)
  (names test_xevent_stubs))
 (libraries x11 alcotest))

(test
 (name run_tests)
 (modules run_tests)
 (libraries test_x11 test_xevent alcotest))

(rule
 (with-stdout-to
  test_xevent_stubs.c.formatted
  (run clang-format %{dep:test_xevent_stubs.c})))

(rule
 (alias fmt)
 (action
  (diff test_xevent_stubs.c test_xevent_stubs.c.formatted)))
