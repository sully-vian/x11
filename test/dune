; Main test library

(test
 (name test_x11)
 (action
  (run %{test} --show-errors))
 (modules test_x11)
 (libraries alcotest test_xevent test_example))

; XEvent conversion tests

(library
 (name test_xevent)
 (modules test_xevent)
 (foreign_stubs
  (language c)
  (names test_xevent_stubs))
 (libraries x11 alcotest))

(library
 (name test_example)
 (modules test_example)
 (libraries x11 alcotest))

(rule
 (with-stdout-to
  test_xevent_stubs.c.formatted
  (run clang-format %{dep:test_xevent_stubs.c})))

(rule
 (alias fmt)
 (action
  (diff test_xevent_stubs.c test_xevent_stubs.c.formatted)))
